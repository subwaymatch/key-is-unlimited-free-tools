# Cloudflare static-asset headers.
# https://developers.cloudflare.com/workers/static-assets/headers/

# Next.js emits content-hashed filenames under /_next/static.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The ffmpeg.wasm class worker and its sibling modules are copied here by
# scripts/copy-ffmpeg-worker.mjs, into a directory named after the pinned
# version, so an upgrade changes every URL at once and nothing stale is reused.
/ffmpeg/*
  Cache-Control: public, max-age=31536000, immutable

# Cross-origin isolation is NOT required: this app uses the single-threaded
# @ffmpeg/core, which does not need SharedArrayBuffer. If you ever switch to
# @ffmpeg/core-mt, uncomment the block below (and re-check that every
# cross-origin resource the page loads sends CORP or CORS headers).
# /*
#   Cross-Origin-Opener-Policy: same-origin
#   Cross-Origin-Embedder-Policy: require-corp
