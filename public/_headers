# Cloudflare static-asset headers.
# https://developers.cloudflare.com/workers/static-assets/headers/

# Next.js emits content-hashed filenames under /_next/static.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The ffmpeg.wasm class worker and its sibling modules are copied here by
# scripts/copy-ffmpeg-worker.mjs, into a directory named after the pinned
# version, so an upgrade changes every URL at once and nothing stale is reused.
/ffmpeg/*
  Cache-Control: public, max-age=31536000, immutable

# Security headers for every response.
#
# The Content-Security-Policy is written against what this app actually loads,
# which is worth stating precisely because two of the entries look wrong until
# you know why they are there:
#
#   script-src 'wasm-unsafe-eval'  ffmpeg is WebAssembly; without this the core
#                                  cannot be compiled at all.
#   script-src 'unsafe-inline'     Next.js's App Router emits inline bootstrap
#                                  scripts (self.__next_f.push(...)) and this is
#                                  a static export, so there is no server to
#                                  stamp a per-response nonce into them. Hashes
#                                  would change on every build. The host
#                                  allowlist is still doing real work.
#   script-src blob:               the ffmpeg core is re-served through a
#                                  same-origin blob: URL (see coreLoader.ts) and
#                                  imported by the worker from there.
#   connect-src cdn.jsdelivr.net   where the ~31 MiB core is fetched from. It
#                                  cannot be self-hosted: Cloudflare's static
#                                  assets cap a single file at 25 MiB and
#                                  ffmpeg-core.wasm is ~30.7 MiB. The bytes are
#                                  checked against a pinned SHA-256 before the
#                                  worker is allowed to run them, so a CDN
#                                  serving something else is refused rather than
#                                  executed.
#
# Everything else is 'self' or off. In particular there is no form-action
# anywhere, no framing, and no connect-src that could carry a file off the
# device - which is the promise this whole site rests on.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; font-src 'self'; worker-src 'self' blob:; connect-src 'self' blob: data: https://cdn.jsdelivr.net https://cloudflareinsights.com; manifest-src 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(), usb=()
  X-Frame-Options: DENY
  Cross-Origin-Resource-Policy: same-origin

# Cross-origin isolation is NOT required: this app uses the single-threaded
# @ffmpeg/core, which does not need SharedArrayBuffer. Switching to
# @ffmpeg/core-mt would mean adding
#   Cross-Origin-Opener-Policy: same-origin
#   Cross-Origin-Embedder-Policy: require-corp
# above, and re-checking that every cross-origin resource the page loads sends
# CORP or CORS headers - the jsDelivr core does, but it would also have to be
# fetched with `crossorigin` set.
