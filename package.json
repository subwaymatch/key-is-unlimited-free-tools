{
  "name": "key-is-unlimited-free-tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:ffmpeg": "node scripts/copy-ffmpeg-worker.mjs",
    "prepare:pdfjs": "node scripts/copy-pdfjs-assets.mjs",
    "prepare:assets": "npm run prepare:ffmpeg && npm run prepare:pdfjs",
    "dev": "npm run prepare:assets && next dev",
    "build": "npm run prepare:assets && next build",
    "start": "wrangler dev",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:characters": "node scripts/check-characters.mjs",
    "generate:images": "node scripts/generate-tool-images.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.41.0",
    "next": "15.5.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@ffmpeg/core": "0.12.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.4",
    "typescript": "^5",
    "vitest": "^3",
    "wrangler": "^4"
  }
}
