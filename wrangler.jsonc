{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "key-is-unlimited-free-tools",
  "compatibility_date": "2026-08-28",

  // Assets-only Worker: no "main" entry point, so every request is served
  // directly from the static asset store. Static asset requests are free and
  // unlimited on all Workers plans.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },

  // Both hostnames are declared here so `wrangler deploy` binds them to this
  // Worker, instead of the binding living only as hand-made records in the
  // dashboard - where the apex silently kept pointing at an old host and
  // served that host's 404 while www worked fine.
  //
  // `custom_domain: true` makes Cloudflare create and own the DNS record for
  // the hostname. That also means a deploy *fails* while a conflicting
  // A/AAAA/CNAME record for the same hostname exists: delete the stale record
  // in the dashboard first, then deploy.
  "routes": [
    { "pattern": "key.is", "custom_domain": true },
    { "pattern": "www.key.is", "custom_domain": true }
  ]
}
